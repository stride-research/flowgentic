# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
venv/

# Secrets — never commit
.env
.env.*
*.env
# ...except the committed templates documenting which vars exist. Must come after the
# patterns above, and must re-whitelist explicitly: `.env.*` would otherwise swallow
# `.env.example` itself, so the template that tells people what to configure would never
# reach the repo.
!.env.example
!**/.env.example

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Run artifacts (mock + real pipeline output)
runs/
*.jsonl
slurm_logs/
reports/
history.jsonl


#Ignore vscode AI rules
.github/instructions/codacy.instructions.md

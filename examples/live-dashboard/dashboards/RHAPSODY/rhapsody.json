{
  "uid": "rhapsody-tasks",
  "title": "RHAPSODY: tasks",
  "description": "RHAPSODY's tasks and nodes, live, from its metrics over OTLP (OtlpTelemetry.rhapsody_options)",
  "tags": [
    "rhapsody"
  ],
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "Flowgentic",
      "type": "dashboards",
      "tags": [
        "flowgentic"
      ],
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 2
      },
      {
        "name": "run",
        "label": "Run",
        "description": "The run: each process's service.namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tasks_submitted_total, service_namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(tasks_submitted_total, service_namespace)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "process",
        "label": "Process",
        "description": "An agent process: its service.instance.id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tasks_submitted_total{service_namespace=~\"$run\"}, service_instance_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(tasks_submitted_total{service_namespace=~\"$run\"}, service_instance_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 2,
      "title": "Tasks",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []

    {
      "type": "timeseries",
      "title": "Tasks per second",
      "description": "RHAPSODY's task counters, summed over the sessions",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(tasks_submitted_total{service_namespace=~\"$run\", service_instance_id=~\"$process\"}[$__rate_interval]))",
          "legendFormat": "submitted",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(tasks_started_total{service_namespace=~\"$run\", service_instance_id=~\"$process\"}[$__rate_interval]))",
          "legendFormat": "started",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(tasks_completed_total{service_namespace=~\"$run\", service_instance_id=~\"$process\"}[$__rate_interval]))",
          "legendFormat": "completed",
          "refId": "C"

    {
      "type": "timeseries",
      "title": "Task duration, mean",
      "description": "A task's duration, by backend (task_duration_seconds). The mean: the histogram has the SDK's default buckets, too coarse for quantiles of short tasks",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (backend) (rate(task_duration_seconds_sum{service_namespace=~\"$run\", service_instance_id=~\"$process\"}[$__rate_interval])) / sum by (backend) (rate(task_duration_seconds_count{service_namespace=~\"$run\", service_instance_id=~\"$process\"}[$__rate_interval]))",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,

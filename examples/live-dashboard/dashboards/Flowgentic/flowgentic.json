      },
      "id": 9,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Requests sent again",
      "description": "Requests sent again after their replica's outage, counted as each is admitted (flowgentic.fleet.retries)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(last_over_time(flowgentic_fleet_retries_total{service_namespace=~\"$run\", service_instance_id=~\"$process\"}[$__range])) or vector(0)",

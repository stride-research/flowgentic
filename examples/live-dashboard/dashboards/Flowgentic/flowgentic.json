          "expr": "sum by (flowgentic_agent_state) (last_over_time(flowgentic_agent_time_seconds_total{service_namespace=~\"$run\", service_instance_id=~\"$process\", flowgentic_agent_state!~\"pending|done\"}[$__range]))",
          "legendFormat": "{{flowgentic_agent_state}}",
          "refId": "A",
          "instant": true,

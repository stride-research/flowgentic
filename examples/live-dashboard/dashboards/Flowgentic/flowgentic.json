    {
      "type": "row",
      "id": 11,
      "title": "Agents",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Agents in each state",
      "description": "Agents in each state, summed over the agent processes (flowgentic.agents); done agents are left out",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (flowgentic_agent_state) (flowgentic_agents{service_namespace=~\"$run\", service_instance_id=~\"$process\", flowgentic_agent_state!=\"done\"})",
          "legendFormat": "{{flowgentic_agent_state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 60,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "insertNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "working"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73bf69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tool_call"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794f2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tool_wait"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fade2a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "model_queued"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "model_request"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b877d9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "done"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c8c8c8"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"

# CageFlow interface residues -- dock_1
# 54 interface residues on chain A, 10 with a heavy-atom contact under 3.0 A.
# Residue numbers are resSeq, as shown in ChimeraX -- NOT ProteinMPNN positions.
open docked_assembly.pdb
hide atoms
show cartoon
color #d0d0d0
# every oligomer a different colour, so the designed interface is visible
color /A,B,C #7fa8d4
color /D,E,F #a8c88a
color /G,H,I #e0b77a
color /J,K,L #c79bd0
# the interface itself
show /A:29,31-32,35-36,39-40,42-43,73-89,123-127,135,168,172-191,193 atoms
style /A:29,31-32,35-36,39-40,42-43,73-89,123-127,135,168,172-191,193 stick
color /A:29,31-32,35-36,39-40,42-43,73-89,123-127,135,168,172-191,193 #d1495b
# contacts under 3.0 A -- look at these first
color /A:43,75,79-80,83-84,176,179-180,186 #ffd166
show /A:43,75,79-80,83-84,176,179-180,186 atoms
label /A:43,75,79-80,83-84,176,179-180,186 residues text "{0.name}{0.number}"
select /A:29,31-32,35-36,39-40,42-43,73-89,123-127,135,168,172-191,193
view

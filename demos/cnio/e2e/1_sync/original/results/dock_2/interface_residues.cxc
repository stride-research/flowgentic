# CageFlow interface residues -- dock_2
# 47 interface residues on chain A, 15 with a heavy-atom contact under 3.0 A.
# Residue numbers are resSeq, as shown in ChimeraX -- NOT ProteinMPNN positions.
open docked_assembly.pdb
hide atoms
show cartoon
color #d0d0d0
# every oligomer a different colour, so the designed interface is visible
color /A,B,C #7fa8d4
color /D,E,F #a8c88a
color /G,H,I #e0b77a
color /J,K,L #c79bd0
# the interface itself
show /A:36,67-72,74-88,90-96,127,131,134-135,138,176-188 atoms
style /A:36,67-72,74-88,90-96,127,131,134-135,138,176-188 stick
color /A:36,67-72,74-88,90-96,127,131,134-135,138,176-188 #d1495b
# contacts under 3.0 A -- look at these first
color /A:67,71-72,75,79-80,82-85,95,180-181,183-184 #ffd166
show /A:67,71-72,75,79-80,82-85,95,180-181,183-184 atoms
label /A:67,71-72,75,79-80,82-85,95,180-181,183-184 residues text "{0.name}{0.number}"
select /A:36,67-72,74-88,90-96,127,131,134-135,138,176-188
view

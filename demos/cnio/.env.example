# Copy to .env in this directory and fill in. .env is gitignored (.env / .env.* / *.env);
# .env.example is committed as the documented list of what a run can be given.
#
# Nothing here is required -- every integration no-ops when its variable is unset, so a run
# with no .env at all behaves exactly as it did before any of this existed.

# Discord incoming webhook for run-status notifications (flowgentic.discord.notify()).
# Create: Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Nothing else to configure on the Discord side -- a webhook posts without needing any bot
# permissions, OAuth scopes, or slash-command registration.
#
# TREAT AS A CREDENTIAL. Anyone with this URL can post to that channel. It is read from the
# environment rather than config.json on purpose: every run copies its config to
# out_dir/config.used.json, which would persist the secret into run artifacts.
#
# Loaded locally from THIS .env file by python-dotenv's load_dotenv() (see e2e/1_sync/
# flowgentic/src/main.py). On the cluster, the launch script points at a separate copy via
# FLOWGENTIC_ENV_FILE instead, since this file is gitignored and never deployed by rsync.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me
